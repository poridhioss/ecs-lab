[Unit]
Description=ECS lab control plane (FastAPI)
After=docker.service network-online.target

[Service]
User=ubuntu
EnvironmentFile=/etc/ecs-lab/ecs-lab.env
WorkingDirectory=/opt/ecs-lab/control-plane
ExecStart=/opt/ecs-lab/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
